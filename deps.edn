{:paths ["src" "resources"]
 :deps {org.jsoup/jsoup {:mvn/version "1.21.2"}
        org.postgresql/postgresql {:mvn/version "42.7.8"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/clojure {:mvn/version "1.12.0"}}
 :mvn/repos {"rpl" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :aliases {:rama {:extra-paths ["integration/src" "integration/resources"]
                 :override-deps {org.clojure/clojure {:mvn/version "1.12.4"}}
                 :extra-deps {com.rpl/rama {:mvn/version "1.9.0"}
                              com.rpl/agent-o-rama {:mvn/version "0.10.0"}}
                 :jvm-opts ["-Xss6m" "-Xmx3g" "-Djdk.attach.allowAttachSelf"]}
           :test-rama {:extra-paths ["integration/test" "test"]
                      :main-opts ["-m" "freediving.evaluation-rama-test"]}
           :test-pipeline-rama {:extra-paths ["integration/test" "test"]
                                :main-opts ["-m" "freediving.pipeline-rama-test"]}
           :test-pipeline {:extra-paths ["test"]
                           :main-opts ["-m" "freediving.pipeline-test"]}
           :labels {:main-opts ["-m" "freediving.evaluation-labels"]}
           :test-labels {:extra-paths ["test"] :main-opts ["-m" "freediving.evaluation-labels-test"]}
           :test-label-integration {:extra-paths ["test"] :main-opts ["-m" "freediving.evaluation-label-integration-test"]}
           :shadow {:main-opts ["-m" "freediving.evaluation-cli"]}
           :test-shadow {:extra-paths ["test"] :main-opts ["-m" "freediving.evaluation-test-runner"]}
           :test-corrections {:extra-paths ["test"] :main-opts ["-m" "freediving.corrections-test"]}
           :test-correction-http {:extra-paths ["test"] :main-opts ["-m" "freediving.correction-http-test"]}
           :public {:main-opts ["-m" "freediving.public-server"]}
           :public-demo {:main-opts ["-m" "freediving.public-demo"]}
           :test-public-server {:extra-paths ["test"] :main-opts ["-m" "freediving.public-server-test"]}
           :test-public-ui {:extra-paths ["test"] :main-opts ["-m" "freediving.public-ui-test"]}
           :test-public-demo {:extra-paths ["test"] :main-opts ["-m" "freediving.public-demo-test"]}
           :owner {:main-opts ["-m" "freediving.owner-server"]}
           :owner-demo {:main-opts ["-m" "freediving.owner-demo"]}
           :test-owner {:extra-paths ["test"] :main-opts ["-m" "freediving.owner-server-test"]}
           :test-owner-ui {:extra-paths ["test"] :main-opts ["-m" "freediving.owner-ui-test"]}
           :publication {:main-opts ["-m" "freediving.publication"]}
           :public-results {:main-opts ["-m" "freediving.public-results"]}
           :test-publication {:extra-paths ["test"] :main-opts ["-m" "freediving.publication-test"]}
           :test-public-results {:extra-paths ["test"] :main-opts ["-m" "freediving.public-results-test"]}
           :packets {:main-opts ["-m" "freediving.packets"]}
           :reviews {:main-opts ["-m" "freediving.reviews"]}
           :test-reviews {:extra-paths ["test"] :main-opts ["-m" "freediving.reviews-test"]}
           :test-postgres {:extra-paths ["test"] :main-opts ["-m" "freediving.observations-test"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "freediving.test-runner"]}
           :observations {:main-opts ["-m" "freediving.observations"]}
           :extract {:main-opts ["-m" "freediving.extraction"]}
           :legacy {:main-opts ["-m" "freediving.legacy"]}
           :archive {:main-opts ["-m" "freediving.archive"]}}}
